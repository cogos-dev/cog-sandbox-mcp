{
  "mcpServers": {
    "cog-sandbox": {
      "command": "podman",
      "args": [
        "run", "--rm", "-i",
        "--network=none",
        "-v", "<ABSOLUTE_PATH_TO_WORKSPACES_ROOT>:/workspace:rw",
        "-e", "COG_SANDBOX_INITIAL_AUTH=<INITIAL_SUBDIR_OR_DOT>",
        "cog-sandbox-mcp:0.6.0"
      ],
      "env": {
        "APPDATA": "<APPDATA>",
        "LOCALAPPDATA": "<LOCALAPPDATA>",
        "USERPROFILE": "<USERPROFILE>"
      }
    }
  }
}
